# Copy to .env and fill in values.

# PostgreSQL connection string used by Prisma.
# Local docker example: docker compose up -d  (see README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmarket?schema=public"

# Mock auth default identity (used when Clerk is not configured).
# The app seeds a default operator + organization and signs every request in as them.
MOCK_AUTH_EMAIL="operator@agentmarket.dev"
MOCK_AUTH_NAME="Default Operator"

# --- Optional: real integrations (mock adapters are used when unset) ---
# Clerk auth (https://clerk.com) — when set, replaces mock auth.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# x402 payments endpoint (mock x402 adapter is used when unset).
# X402_FACILITATOR_URL=

# A2A (agent-to-agent) registry endpoint (local adapter used when unset).
# A2A_REGISTRY_URL=

# MCP gateway endpoint (local mock adapter used when unset).
# MCP_GATEWAY_URL=
